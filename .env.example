# Huolala Figma MCP 环境变量模板
# 复制为 .env 后填写
#命令 cp .env.example .env

# ── Figma（必填）──────────────────────────────────────
MDAP_FIGMA_TOKEN=figd_xxxxxxxx
# ── 服务运行 ──────────────────────────────────────────
# HTTP 客户端 SSL / 超时（生产环境保持 MDAP_SSL_VERIFY=true）
# 未设置 MDAP_CA_BUNDLE 时，自动按 OS 选择：certifi > 系统证书路径
MDAP_SSL_VERIFY=false
# MDAP_CA_BUNDLE=/path/to/ca-bundle.crt
# MDAP_HTTP_TIMEOUT=30

# 对外可访问根 URL（{PORT} 会替换为上方 PORT）
PORT=10001
LOG_LEVEL=INFO
MDAP_APP_BASE_URL=http://localhost:{PORT}
# ── ZIP 本地下载服务 ──────────────────────────────────
# MDAP_EXPORT_LOCAL_DIR=runtime/exports
MDAP_EXPORT_HTTP_HOST=127.0.0.1
MDAP_EXPORT_HTTP_PORT=18081

# ── SQLite 节点缓存 ───────────────────────────────────
# MDAP_U2C_SQLITE_CACHE=runtime/cache/mdap_u2c.sqlite3

# ── VLM 多模态（可选，默认 none 不启用）───────────────
MDAP_VLM_PROVIDER=none

# 本地测试可用Ollama（复用 openai 兼容 Provider，需 vision 模型如 qwen3.5:9b），生成环境建议GPT-5等更强的模型
# MDAP_VLM_PROVIDER=openai
# MDAP_VLM_BASE_URL=http://127.0.0.1:11434/v1
# MDAP_VLM_MODEL=qwen3.5:9b
# MDAP_VLM_API_KEY=ollama
# MDAP_VLM_TIMEOUT=500  # 单次 API 与 pipeline 等待 VLM 任务的超时（秒）
# MDAP_VLM_JSON_MODE=true

